[Unit]
Description=lightBot coder model (llama.cpp Vulkan on the Arc B390), 127.0.0.1:8080; bigbuddy reaches it through an SSH tunnel

[Service]
ExecStart=%h/llm/llama.cpp/build/bin/llama-server -m %h/llm/models/rosorin-coder-7b-v2-Q4_K_M.gguf --alias rosorin-coder -ngl 99 -c 16384 --host 127.0.0.1 --port 8080 --jinja
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
