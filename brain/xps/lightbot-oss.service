[Unit]
Description=lightBot gpt-oss-20b (llama.cpp Vulkan on the Arc B390), 127.0.0.1:8082; bigbuddy reaches it through an SSH tunnel

[Service]
ExecStart=%h/llm/llama.cpp/build/bin/llama-server -m %h/llm/models/gpt-oss-20b.gguf --alias gpt-oss-20b -ngl 99 -c 16384 --host 127.0.0.1 --port 8082 --jinja
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
