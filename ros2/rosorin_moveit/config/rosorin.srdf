<?xml version="1.0"?>
<!-- rosorin arm for MoveIt (2026-09-29). Named states = owner-designed/taught poses (pulses -> rad:
     rad = (500 - pulse) * 0.0041888, model/robot_model.json). Tuck is NOT here: it is outside the joint-2
     limit on purpose and stays a driver service (~/arm/tuck). -->
<robot name="rosorin">
  <group name="arm"><chain base_link="base_link" tip_link="link5"/></group>
  <group_state name="rest" group="arm"><joint name="joint1" value="0.0"/><joint name="joint2" value="-1.50796"/><joint name="joint3" value="1.9059"/><joint name="joint4" value="1.34879"/><joint name="joint5" value="0.0"/></group_state>
  <group_state name="drive" group="arm"><joint name="joint1" value="0.0"/><joint name="joint2" value="-1.22732"/><joint name="joint3" value="1.88077"/><joint name="joint4" value="1.42419"/><joint name="joint5" value="0.0"/></group_state>
  <group_state name="look_down_a" group="arm"><joint name="joint1" value="0.0"/><joint name="joint2" value="1.25664"/><joint name="joint3" value="1.17286"/><joint name="joint4" value="0.70791"/><joint name="joint5" value="0.0"/></group_state>
  <group_state name="look_down_b" group="arm"><joint name="joint1" value="0.0"/><joint name="joint2" value="1.3823"/><joint name="joint3" value="0.12566"/><joint name="joint4" value="1.12678"/><joint name="joint5" value="0.0"/></group_state>
  <group_state name="touch_your_toes" group="arm"><joint name="joint1" value="0.06702"/><joint name="joint2" value="1.03044"/><joint name="joint3" value="1.02625"/><joint name="joint4" value="1.43676"/><joint name="joint5" value="0.01676"/></group_state>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="camera_link0" reason="Adjacent"/>
  <disable_collisions link1="camera_link0" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <!-- model false positive: any joint-5 roll flags link5 vs the camera mount (arm_poses.yaml note) -->
  <disable_collisions link1="link5" link2="camera_link0" reason="Never"/>
</robot>
