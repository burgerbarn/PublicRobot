#!/usr/bin/env bash
# Simulated rebuild: the owner's hands on the emulated controller board, from the Mac.
#   scripts/sim/hands pad <buttons> <hat> <lx> <ly> <rx> <ry> [seconds]   gamepad state (raw values) held for N s
#   scripts/sim/hands key                                                  press the board's key 1
# Raw gamepad values as the board reports them (<HB4b>: buttons bitmask, hat, axes -127..127, factory order).
set -euo pipefail
case "${1:-}" in
  pad) msg=$(printf '{"pad": {"buttons": %d, "hat": %d, "axes": [%d, %d, %d, %d]}, "for": %s}' "$2" "$3" "$4" "$5" "$6" "$7" "${8:-1}");;
  key) msg='{"key": 1}';;
  *) echo "usage: hands pad <buttons> <hat> <lx> <ly> <rx> <ry> [seconds] | hands key"; exit 2;;
esac
ssh bigbuddy "docker exec -i lbsim-robot python3 -c 'import socket,sys; socket.socket(socket.AF_INET, socket.SOCK_DGRAM).sendto(sys.stdin.read().encode(), (\"127.0.0.1\", 5603))'" <<<"$msg"
echo "hands: $msg"
